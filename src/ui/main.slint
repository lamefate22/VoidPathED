export component MainWindow inherits Window {
    background: transparent;
    title: "VoidPath ED";
    always-on-top: true;
    no-frame: true;
    height: 94px;
    width: 650px;

    // View States
    in property <bool> is-route: false;
    in property <bool> is-searching-route: false;
    in property <bool> journal-connected: false;
    in property <string> search-status-text: "Calculating route on Spansh (queue ~2-4 min)...";
    in property <string> error-text: "";
    in property <string> starting-location-text: "Sol / Galileo";

    // Active Hop Data
    in property <int> current-hop: 1;
    in property <int> total-hops: 1;
    in property <string> hop-distance: "0.0 LY";
    in property <string> hop-profit: "0 CR";
    in property <string> total-profit: "0 CR";

    // Source Info (Buy)
    in property <string> source-system: "Sol";
    in property <string> source-station: "Galileo";
    in property <string> source-dist: "0 ls";
    in property <string> commodity-name: "Gold";
    in property <string> commodity-amount: "0 t";
    in property <string> buy-price: "0 CR";

    // Destination Info (Sell)
    in property <string> dest-system: "Alpha Centauri";
    in property <string> dest-station: "Hutton Orbital";
    in property <string> dest-dist: "0 ls";
    in property <string> sell-price: "0 CR";
    in property <string> unit-profit: "+0 CR/t";

    // Notification toast / feedback
    in property <string> notification-message: "";
    in property <bool> show-notification: false;

    // Animation helper for search spinner
    in-out property <float> search-spinner-angle: 0;

    // Ship & Cargo Info
    in property <string> ship-info-text: "";
    in property <string> cargo-info-text: "";
    in property <bool> is-click-through: false;

    // Callbacks
    callback close-window();
    callback search-route();
    callback open-settings();
    callback next-hop();
    callback prev-hop();
    callback copy-dest-system();
    callback clear-route();
    callback window-drag-started();
    callback toggle-click-through();

    Timer {
        interval: 16ms;
        running: is-searching-route;
        triggered => {
            search-spinner-angle = mod(search-spinner-angle + 6, 360);
        }
    }

    Rectangle {
        background: #101115;
        border-radius: 8px;
        border-width: 1px;
        border-color: #FFFFFF16;
        clip: true;
        width: 100%;
        height: 100%;

        VerticalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 6px;
            padding-bottom: 6px;
            spacing: 5px;

            // 1. TOP HEADER ROW (Height: 20px)
            HorizontalLayout {
                height: 20px;
                spacing: 8px;

                // Left: Badges (Ship info & Cargo hold)
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    if root.ship-info-text != "": Rectangle {
                        background: #ffffff0a;
                        border-radius: 4px;
                        border-width: 0.5px;
                        border-color: #ffffff14;
                        height: 20px;

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 5px;

                            Rectangle {
                                width: 5px;
                                height: 5px;
                                border-radius: 2.5px;
                                background: root.journal-connected ? #5DCAA5 : #8E8E93;
                                y: 7.5px;
                            }

                            Text {
                                text: root.ship-info-text;
                                color: #FFFFFFB0;
                                font-size: 10px;
                                font-family: "Inter";
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if root.cargo-info-text != "": Rectangle {
                        background: #5DCAA514;
                        border-radius: 4px;
                        border-width: 0.5px;
                        border-color: #5DCAA535;
                        height: 20px;

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;

                            Text {
                                text: root.cargo-info-text;
                                color: #5DCAA5;
                                font-size: 10px;
                                font-family: "Inter";
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Middle: Drag Handle (fills remaining space)
                TouchArea {
                    horizontal-stretch: 1;
                    mouse-cursor: move;
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            root.window-drag-started();
                        }
                    }
                }

                // Right: Action Controls (Lock, Settings, Close)
                HorizontalLayout {
                    spacing: 4px;
                    alignment: end;

                    // Click-through Lock Button
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        border-radius: 4px;
                        background: root.is-click-through ? #5DCAA525 : (ct-area.has-hover ? #ffffff15 : transparent);
                        border-width: root.is-click-through ? 0.5px : 0px;
                        border-color: #5DCAA560;

                        Image {
                            source: root.is-click-through ? @image-url("assets/lock.svg") : @image-url("assets/unlock.svg");
                            colorize: root.is-click-through ? #5DCAA5 : (ct-area.has-hover ? #ffffff : #8E8E93);
                            height: 12px;
                            width: 12px;
                        }

                        ct-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle-click-through(); }
                        }
                    }

                    // Settings Button
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        border-radius: 4px;
                        background: settings-area.has-hover ? #ffffff15 : transparent;

                        Image {
                            colorize: settings-area.has-hover ? #ffffff : #8E8E93;
                            source: @image-url("assets/settings.svg");
                            height: 12px;
                            width: 12px;
                        }

                        settings-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open-settings(); }
                        }
                    }

                    // Close Button
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        border-radius: 4px;
                        background: close-area.has-hover ? #ff5f5725 : transparent;

                        Image {
                            colorize: close-area.has-hover ? #ff5f57 : #8E8E93;
                            source: @image-url("assets/close.svg");
                            height: 12px;
                            width: 12px;
                        }

                        close-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.close-window(); }
                        }
                    }
                }
            }

            // 2. MAIN CONTENT CARD (Height: 56px)
            Rectangle {
                background: #ffffff06;
                border-radius: 6px;
                border-width: 0.5px;
                border-color: #ffffff0e;
                height: 56px;

                // --- STATE 1: SEARCHING ---
                if is-searching-route: HorizontalLayout {
                    alignment: center;
                    spacing: 8px;

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("assets/spinner.svg");
                            transform-rotation: search-spinner-angle * 1deg;
                            colorize: #5DCAA5;
                            height: 18px;
                            width: 18px;
                        }
                    }

                    Text {
                        text: root.search-status-text;
                        font-family: "Inter";
                        font-size: 11px;
                        color: #FFFFFFB3;
                        vertical-alignment: center;
                    }
                }

                // --- STATE 2: NO ACTIVE ROUTE ---
                if !is-route && !is-searching-route: HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 8px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        Text {
                            text: "Start:";
                            font-family: "Inter";
                            font-size: 11px;
                            color: #FFFFFF50;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.starting-location-text;
                            font-family: "Inter";
                            font-size: 11px;
                            font-weight: 600;
                            color: #FFFFFFF0;
                            vertical-alignment: center;
                        }

                        if root.error-text != "": Text {
                            text: "• " + root.error-text;
                            color: #FF6B6B;
                            font-size: 10px;
                            font-family: "Inter";
                            vertical-alignment: center;
                        }
                    }

                    VerticalLayout {
                        alignment: center;

                        Rectangle {
                            background: search-btn.has-hover ? #4db896 : #5DCAA5;
                            border-radius: 4px;
                            height: 26px;
                            width: 140px;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 5px;

                                Image {
                                    source: @image-url("assets/search.svg");
                                    colorize: #04342C;
                                    height: 12px;
                                    width: 12px;
                                    y: 7px;
                                }

                                Text {
                                    text: "Find Trade Route";
                                    color: #04342C;
                                    font-family: "Inter";
                                    font-size: 11px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            search-btn := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.search-route(); }
                            }
                        }
                    }
                }

                // --- STATE 3: ACTIVE ROUTE (Symmetrical 2-Row Card) ---
                if is-route && !is-searching-route: VerticalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 5px;
                    padding-bottom: 5px;
                    spacing: 4px;

                    // Row 1: Destination & Navigation Controls (Height: 22px)
                    HorizontalLayout {
                        height: 22px;
                        alignment: space-between;

                        // Left: Target destination info
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;

                            // Hop Pill
                            VerticalLayout {
                                alignment: center;

                                Rectangle {
                                    background: #5DCAA520;
                                    border-radius: 3px;
                                    border-width: 0.5px;
                                    border-color: #5DCAA550;
                                    height: 18px;

                                    HorizontalLayout {
                                        padding-left: 5px;
                                        padding-right: 5px;

                                        Text {
                                            text: root.current-hop + "/" + root.total-hops;
                                            color: #5DCAA5;
                                            font-size: 10px;
                                            font-family: "Inter";
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            Text {
                                text: root.dest-system;
                                color: #FFFFFF;
                                font-size: 12px;
                                font-family: "Inter";
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "(" + root.dest-station + ")";
                                color: #FFFFFF80;
                                font-size: 11px;
                                font-family: "Inter";
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        // Right: Hop actions (Prev, Next, Copy, Clear)
                        HorizontalLayout {
                            spacing: 4px;
                            alignment: end;

                            VerticalLayout {
                                alignment: center;

                                Rectangle {
                                    background: prev-btn.has-hover ? #ffffff18 : #ffffff0a;
                                    border-radius: 3px;
                                    height: 20px;
                                    width: 36px;

                                    Text {
                                        text: "‹ Prev";
                                        color: #FFFFFF80;
                                        font-size: 9px;
                                        font-family: "Inter";
                                        font-weight: 500;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    prev-btn := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.prev-hop(); }
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;

                                Rectangle {
                                    background: next-btn.has-hover ? #4db896 : #5DCAA5;
                                    border-radius: 3px;
                                    height: 20px;
                                    width: 48px;

                                    Text {
                                        text: "Next ›";
                                        color: #04342C;
                                        font-size: 10px;
                                        font-family: "Inter";
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    next-btn := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.next-hop(); }
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;

                                Rectangle {
                                    background: copy-btn.has-hover ? #5DCAA530 : #ffffff10;
                                    border-radius: 3px;
                                    border-width: 0.5px;
                                    border-color: copy-btn.has-hover ? #5DCAA560 : #ffffff15;
                                    height: 20px;

                                    HorizontalLayout {
                                        padding-left: 7px;
                                        padding-right: 7px;
                                        alignment: center;

                                        Text {
                                            text: "Copy";
                                            color: copy-btn.has-hover ? #5DCAA5 : #FFFFFFF0;
                                            font-size: 10px;
                                            font-family: "Inter";
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }

                                    copy-btn := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.copy-dest-system(); }
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;

                                Rectangle {
                                    background: clear-btn.has-hover ? #FF5F5725 : transparent;
                                    border-radius: 3px;
                                    height: 20px;
                                    width: 20px;

                                    Image {
                                        source: @image-url("assets/close.svg");
                                        colorize: clear-btn.has-hover ? #FF5F57 : #FFFFFF50;
                                        height: 10px;
                                        width: 10px;
                                    }

                                    clear-btn := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.clear-route(); }
                                    }
                                }
                            }
                        }
                    }

                    // Row 2: Trade & Route Details (Height: 18px)
                    HorizontalLayout {
                        height: 18px;
                        alignment: space-between;

                        // Left: Cargo & Profit Details
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;

                            Text {
                                text: root.commodity-amount + " " + root.commodity-name;
                                color: #60A5FA;
                                font-size: 10px;
                                font-family: "Inter";
                                font-weight: 500;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Text {
                                text: "•";
                                color: #FFFFFF30;
                                font-size: 10px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: root.hop-profit;
                                color: #5DCAA5;
                                font-size: 10px;
                                font-family: "Inter";
                                font-weight: 600;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "(" + root.hop-distance + ")";
                                color: #FFFFFF60;
                                font-size: 10px;
                                font-family: "Inter";
                                vertical-alignment: center;
                            }

                            if root.dest-dist != "": Text {
                                text: "• arr: " + root.dest-dist;
                                color: #FFFFFF50;
                                font-size: 10px;
                                font-family: "Inter";
                                vertical-alignment: center;
                            }
                        }

                        // Right: Route Total Profit
                        HorizontalLayout {
                            alignment: end;

                            Text {
                                text: "Route: " + root.total-profit;
                                color: #5DCAA590;
                                font-size: 10px;
                                font-family: "Inter";
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Notification Toast (Floating pill at top center)
        if show-notification: Rectangle {
            x: (parent.width - self.width) / 2;
            y: 4px;
            background: #101115F5;
            border-radius: 4px;
            border-width: 0.5px;
            border-color: #5DCAA590;
            height: 20px;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;

                Text {
                    text: root.notification-message;
                    color: #5DCAA5;
                    font-size: 10px;
                    font-family: "Inter";
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }
    }
}
