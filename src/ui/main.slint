export component MainWindow inherits Window {
    background: transparent;
    title: "VoidPath ED";
    always-on-top: true;
    no-frame: true;
    height: 126px;
    width: 620px;

    // View States
    in property <bool> is-route: false;
    in property <bool> is-searching-route: false;
    in property <bool> journal-connected: false;
    in property <string> search-status-text: "Calculating optimal trade route...";
    in property <string> error-text: "";
    in property <string> starting-location-text: "Sol / Galileo";

    // Active Hop Data
    in property <int> current-hop: 1;
    in property <int> total-hops: 1;
    in property <string> hop-distance: "0.0 LY";
    in property <string> hop-profit: "0 CR";
    in property <string> total-profit: "0 CR";

    // Source Info (Buy)
    in property <string> source-system: "Sol";
    in property <string> source-station: "Galileo";
    in property <string> source-dist: "0 ls";
    in property <string> commodity-name: "Gold";
    in property <string> commodity-amount: "0 t";
    in property <string> buy-price: "0 CR";

    // Destination Info (Sell)
    in property <string> dest-system: "Alpha Centauri";
    in property <string> dest-station: "Hutton Orbital";
    in property <string> dest-dist: "0 ls";
    in property <string> sell-price: "0 CR";
    in property <string> unit-profit: "+0 CR/t";

    // Notification toast / feedback
    in property <string> notification-message: "";
    in property <bool> show-notification: false;

    // Animation helper for search spinner
    in-out property <float> search-spinner-angle: 0;

    // Ship & Cargo Info
    in property <string> ship-info-text: "";
    in property <string> cargo-info-text: "";
    in property <bool> is-click-through: false;

    // Callbacks
    callback close-window();
    callback search-route();
    callback open-settings();
    callback next-hop();
    callback prev-hop();
    callback copy-dest-system();
    callback clear-route();
    callback window-drag-started();
    callback toggle-click-through();

    Timer {
        interval: 16ms;
        running: is-searching-route;
        triggered => {
            search-spinner-angle = mod(search-spinner-angle + 6, 360);
        }
    }

    Rectangle {
        background: #111217;
        border-radius: 8px;
        border-width: 1px;
        border-color: #FFFFFF16;
        clip: true;
        width: 100%;
        height: 100%;

        VerticalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 7px;
            padding-bottom: 7px;
            spacing: 5px;

            // 1. TOP BAR ROW (Clean Header, height: 22px)
            HorizontalLayout {
                height: 22px;
                spacing: 8px;

                // Left: Badges (Ship info & Cargo hold)
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    if root.ship-info-text != "": Rectangle {
                        background: #ffffff0a;
                        border-radius: 4px;
                        border-width: 0.5px;
                        border-color: #ffffff14;
                        height: 20px;

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 5px;

                            Rectangle {
                                width: 5px;
                                height: 5px;
                                border-radius: 2.5px;
                                background: root.journal-connected ? #5DCAA5 : #8E8E93;
                                y: 7.5px;
                            }

                            Text {
                                text: root.ship-info-text;
                                color: #FFFFFFB0;
                                font-size: 10px;
                                font-family: "Inter";
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if root.cargo-info-text != "": Rectangle {
                        background: #5DCAA514;
                        border-radius: 4px;
                        border-width: 0.5px;
                        border-color: #5DCAA535;
                        height: 20px;

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;

                            Text {
                                text: root.cargo-info-text;
                                color: #5DCAA5;
                                font-size: 10px;
                                font-family: "Inter";
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Middle: Drag Handle (fills all available space between badges and buttons)
                TouchArea {
                    horizontal-stretch: 1;
                    mouse-cursor: move;
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            root.window-drag-started();
                        }
                    }
                }

                // Right: Action Controls (Lock, Settings, Close)
                HorizontalLayout {
                    spacing: 4px;
                    alignment: end;

                    // Click-through Lock Button
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: 4px;
                        background: root.is-click-through ? #5DCAA525 : (ct-area.has-hover ? #ffffff15 : transparent);
                        border-width: root.is-click-through ? 0.5px : 0px;
                        border-color: #5DCAA560;

                        Image {
                            source: root.is-click-through ? @image-url("assets/lock.svg") : @image-url("assets/unlock.svg");
                            colorize: root.is-click-through ? #5DCAA5 : (ct-area.has-hover ? #ffffff : #8E8E93);
                            height: 13px;
                            width: 13px;
                        }

                        ct-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle-click-through(); }
                        }
                    }

                    // Settings Button
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: 4px;
                        background: settings-area.has-hover ? #ffffff15 : transparent;

                        Image {
                            colorize: settings-area.has-hover ? #ffffff : #8E8E93;
                            source: @image-url("assets/settings.svg");
                            height: 13px;
                            width: 13px;
                        }

                        settings-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open-settings(); }
                        }
                    }

                    // Close Button
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: 4px;
                        background: close-area.has-hover ? #ff5f5725 : transparent;

                        Image {
                            colorize: close-area.has-hover ? #ff5f57 : #8E8E93;
                            source: @image-url("assets/close.svg");
                            height: 13px;
                            width: 13px;
                        }

                        close-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.close-window(); }
                        }
                    }
                }
            }

            // 2. MAIN CONTENT BODY (Takes remaining height, centered)
            VerticalLayout {
                vertical-stretch: 1;
                alignment: center;

                // --- STATE 1: SEARCHING ---
                if is-searching-route: HorizontalLayout {
                    alignment: center;
                    spacing: 8px;

                    Image {
                        source: @image-url("assets/spinner.svg");
                        transform-rotation: search-spinner-angle * 1deg;
                        colorize: #5DCAA5;
                        height: 22px;
                        width: 22px;
                    }

                    Text {
                        text: root.search-status-text;
                        font-family: "Inter";
                        font-size: 11px;
                        color: #FFFFFFB3;
                        vertical-alignment: center;
                    }
                }

                // --- STATE 2: NO ACTIVE ROUTE ---
                if !is-route && !is-searching-route: VerticalLayout {
                    alignment: center;
                    spacing: 6px;

                    HorizontalLayout {
                        alignment: space-between;
                        padding-left: 4px;
                        padding-right: 4px;

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;

                            Text {
                                text: "Start:";
                                font-family: "Inter";
                                font-size: 11px;
                                color: #FFFFFF50;
                                vertical-alignment: center;
                            }

                            Text {
                                text: root.starting-location-text;
                                font-family: "Inter";
                                font-size: 12px;
                                font-weight: 600;
                                color: #FFFFFFF0;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            background: search-btn.has-hover ? #4db896 : #5DCAA5;
                            border-radius: 5px;
                            height: 26px;
                            width: 135px;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 5px;

                                Image {
                                    source: @image-url("assets/search.svg");
                                    colorize: #04342C;
                                    height: 12px;
                                    width: 12px;
                                    y: 7px;
                                }

                                Text {
                                    text: "Find Trade Route";
                                    color: #04342C;
                                    font-family: "Inter";
                                    font-size: 11px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            search-btn := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.search-route(); }
                            }
                        }
                    }

                    if error-text != "": Text {
                        text: root.error-text;
                        color: #FF6B6B;
                        font-size: 10px;
                        font-family: "Inter";
                        horizontal-alignment: center;
                    }
                }

                // --- STATE 3: ACTIVE ROUTE CARD ---
                if is-route && !is-searching-route: VerticalLayout {
                    spacing: 4px;
                    alignment: center;

                    // Row 1: Hop & Profit Ticker
                    HorizontalLayout {
                        alignment: space-between;
                        padding-left: 2px;
                        padding-right: 2px;

                        HorizontalLayout {
                            spacing: 6px;

                            Rectangle {
                                background: #5DCAA520;
                                border-radius: 3px;
                                border-width: 0.5px;
                                border-color: #5DCAA550;
                                height: 16px;

                                HorizontalLayout {
                                    padding-left: 5px;
                                    padding-right: 5px;

                                    Text {
                                        text: "HOP " + root.current-hop + " / " + root.total-hops;
                                        color: #5DCAA5;
                                        font-size: 9px;
                                        font-family: "Inter";
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            Text {
                                text: root.hop-distance;
                                color: #FFFFFF80;
                                font-size: 11px;
                                font-family: "Inter";
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;

                            Text {
                                text: root.hop-profit;
                                color: #5DCAA5;
                                font-size: 11px;
                                font-family: "Inter";
                                font-weight: 600;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "(" + root.unit-profit + ")";
                                color: #5DCAA5B0;
                                font-size: 10px;
                                font-family: "Inter";
                                vertical-alignment: center;
                            }

                            Rectangle { width: 1px; height: 10px; background: #ffffff14; y: 3px; }

                            Text {
                                text: "Total: " + root.total-profit;
                                color: #FFFFFF90;
                                font-size: 11px;
                                font-family: "Inter";
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Row 2: Streamlined Route Flow Banner
                    Rectangle {
                        background: #0B0C0F;
                        border-radius: 5px;
                        border-width: 0.5px;
                        border-color: #ffffff10;
                        height: 38px;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            alignment: space-between;

                            // Source Buy Info
                            VerticalLayout {
                                alignment: center;
                                spacing: 1px;
                                horizontal-stretch: 1;

                                HorizontalLayout {
                                    spacing: 4px;

                                    Text {
                                        text: "BUY";
                                        color: #60A5FA;
                                        font-size: 9px;
                                        font-family: "Inter";
                                        font-weight: 700;
                                    }

                                    Text {
                                        text: root.commodity-name + " (" + root.commodity-amount + ")";
                                        color: #FFFFFF;
                                        font-size: 11px;
                                        font-family: "Inter";
                                        font-weight: 600;
                                    }
                                }

                                Text {
                                    text: root.source-system + " • " + root.source-station + " (" + root.source-dist + ")";
                                    color: #FFFFFF60;
                                    font-size: 10px;
                                    font-family: "Inter";
                                }
                            }

                            // Center Arrow
                            VerticalLayout {
                                alignment: center;
                                padding-left: 4px;
                                padding-right: 4px;

                                Text {
                                    text: "➔";
                                    color: #5DCAA5;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                }
                            }

                            // Dest Sell Info
                            VerticalLayout {
                                alignment: center;
                                spacing: 1px;
                                horizontal-stretch: 1;

                                HorizontalLayout {
                                    spacing: 4px;
                                    alignment: end;

                                    Text {
                                        text: "SELL";
                                        color: #34D399;
                                        font-size: 9px;
                                        font-family: "Inter";
                                        font-weight: 700;
                                    }

                                    Text {
                                        text: root.dest-system;
                                        color: #FFFFFF;
                                        font-size: 11px;
                                        font-family: "Inter";
                                        font-weight: 600;
                                    }
                                }

                                Text {
                                    text: root.dest-station + " (" + root.dest-dist + ")";
                                    color: #FFFFFF60;
                                    font-size: 10px;
                                    font-family: "Inter";
                                    horizontal-alignment: end;
                                }
                            }
                        }
                    }

                    // Row 3: Compact Nav Actions
                    HorizontalLayout {
                        alignment: space-between;
                        padding-left: 2px;
                        padding-right: 2px;

                        HorizontalLayout {
                            spacing: 4px;

                            Rectangle {
                                background: prev-btn.has-hover ? #ffffff18 : #ffffff0a;
                                border-radius: 4px;
                                height: 22px;
                                width: 50px;

                                Text {
                                    text: "‹ Prev";
                                    color: #FFFFFF80;
                                    font-size: 10px;
                                    font-family: "Inter";
                                    font-weight: 500;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                prev-btn := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.prev-hop(); }
                                }
                            }

                            Rectangle {
                                background: next-btn.has-hover ? #5DCAA540 : #5DCAA520;
                                border-radius: 4px;
                                border-width: 0.5px;
                                border-color: #5DCAA550;
                                height: 22px;
                                width: 62px;

                                Text {
                                    text: "Next ›";
                                    color: #5DCAA5;
                                    font-size: 10px;
                                    font-family: "Inter";
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                next-btn := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.next-hop(); }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 4px;

                            Rectangle {
                                background: copy-btn.has-hover ? #ffffff18 : #ffffff0a;
                                border-radius: 4px;
                                height: 22px;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 4px;

                                    Text {
                                        text: "Copy " + root.dest-system;
                                        color: copy-btn.has-hover ? #FFFFFF : #5DCAA5;
                                        font-size: 10px;
                                        font-family: "Inter";
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }

                                copy-btn := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.copy-dest-system(); }
                                }
                            }

                            Rectangle {
                                background: clear-btn.has-hover ? #FF5F5725 : transparent;
                                border-radius: 4px;
                                height: 22px;
                                width: 44px;

                                Text {
                                    text: "Clear";
                                    color: clear-btn.has-hover ? #FF5F57 : #FFFFFF40;
                                    font-size: 10px;
                                    font-family: "Inter";
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                clear-btn := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.clear-route(); }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Notification Toast (Floating pill at top center)
        if show-notification: Rectangle {
            x: (parent.width - self.width) / 2;
            y: 6px;
            background: #101115F0;
            border-radius: 4px;
            border-width: 0.5px;
            border-color: #5DCAA580;
            height: 22px;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;

                Text {
                    text: root.notification-message;
                    color: #5DCAA5;
                    font-size: 10px;
                    font-family: "Inter";
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }
    }
}
