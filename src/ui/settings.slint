import { ScrollView, LineEdit, ListView } from "std-widgets.slint";

export struct StationSuggestion {
    name: string,
    system: string,
}

component SettingInputRow inherits Rectangle {
    in property <string> label;
    in-out property <string> text;
    in property <string> placeholder: "";
    callback edited(string);

    border-color: #FFFFFF0D;
    background: #ffffff05;
    border-width: 0.5px;
    border-radius: 5px;
    height: 32px;

    HorizontalLayout {
        alignment: space-between;
        padding-right: 10px;
        padding-left: 10px;

        Text {
            vertical-alignment: center;
            color: #FFFFFF99;
            text: root.label;
            font-size: 11px;
            font-family: "Inter";
        }

        VerticalLayout {
            alignment: center;

            LineEdit {
                text <=> root.text;
                placeholder-text: root.placeholder;
                font-size: 11px;
                width: 110px;
                height: 22px;
                edited(val) => { root.edited(val); }
            }
        }
    }
}

component SettingToggleRow inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked;
    callback toggled(bool);

    border-color: #FFFFFF0D;
    background: #ffffff05;
    border-width: 0.5px;
    border-radius: 5px;
    height: 32px;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: space-between;

        Text {
            text: root.label;
            color: #FFFFFF99;
            font-size: 11px;
            font-family: "Inter";
            vertical-alignment: center;
        }

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 28px;
                height: 16px;
                border-radius: 8px;
                background: root.checked ? #5DCAA5 : #ffffff18;
                animate background { duration: 150ms; }

                Rectangle {
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: #ffffff;
                    x: root.checked ? 14px : 2px;
                    y: 2px;
                    animate x { duration: 150ms; }
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.checked = !root.checked;
                        root.toggled(root.checked);
                    }
                }
            }
        }
    }
}

export component SettingsWindow inherits Window {
    title: "VoidPath ED Settings";
    background: transparent;
    always-on-top: true;
    no-frame: true;
    height: 580px;
    width: 460px;

    callback station-selected(string, string);
    callback station-query-changed(string);
    callback auto-detect-location();
    callback close-window();
    callback save();
    callback browse-journal-path();
    callback hotkey-key-pressed(string, bool, bool, bool, bool);
    callback hotkey-recording-started();
    callback hotkey-recording-ended();
    callback window-drag-started();

    in property <[StationSuggestion]> station-suggestions: [];
    in-out property <string> starting-point: "Sol / Galileo";
    in-out property <string> selected-station: "Galileo";
    in-out property <string> selected-system: "Sol";
    in-out property <bool> show-suggestions: false;
    in property <string> detected-ship-info: "";

    // Route Parameters
    in-out property <int> max-hops: 10;
    in-out property <int> max-cargo: 500;
    in-out property <int> max-price-age: 28800;
    in-out property <int> max-hop-distance: 20;
    in-out property <int> starting-capital: 1000000;
    in-out property <int> max-system-distance: 100000000;

    // Filters
    in-out property <bool> allow-planetary: false;
    in-out property <bool> permit: false;
    in-out property <bool> allow-prohibited: false;
    in-out property <bool> requires-large-pad: true;
    in-out property <bool> allow-player-owned: true;
    in-out property <bool> unique: false;
    in-out property <bool> allow-restricted-access: false;

    // App Settings
    in-out property <bool> auto-advance-route: true;
    in-out property <bool> auto-sync-ship: true;
    in-out property <bool> auto-copy-system: true;
    in-out property <bool> sound-enabled: true;
    in-out property <string> hotkey-str: "Ctrl+Shift+V";
    in-out property <bool> is-recording-hotkey: false;
    in-out property <string> journal-path: "";

    // Hotkey recording FocusScope
    hotkey-focus := FocusScope {
        key-pressed(event) => {
            if (root.is-recording-hotkey) {
                root.hotkey-key-pressed(
                    event.text,
                    event.modifiers.control,
                    event.modifiers.alt,
                    event.modifiers.shift,
                    event.modifiers.meta
                );
                return accept;
            }
            reject
        }
    }

    Rectangle {
        background: #101115;
        border-radius: 8px;
        border-width: 1px;
        border-color: #FFFFFF16;
        height: 100%;
        width: 100%;
        clip: true;

        VerticalLayout {
            // Header (Draggable)
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 8px;
                padding-bottom: 8px;
                alignment: space-between;
                height: 36px;

                // Drag handle area spanning the header
                TouchArea {
                    horizontal-stretch: 1;
                    mouse-cursor: move;
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            root.window-drag-started();
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    Rectangle {
                        height: 20px;
                        width: 20px;
                        border-radius: 4px;
                        background: close-top-area.has-hover ? #ff5f5725 : transparent;

                        Image {
                            source: @image-url("assets/close.svg");
                            colorize: close-top-area.has-hover ? #ff5f57 : #707070;
                            height: 14px;
                            width: 14px;
                        }

                        close-top-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if (root.is-recording-hotkey) {
                                    root.is-recording-hotkey = false;
                                    root.hotkey-recording-ended();
                                }
                                root.close-window();
                            }
                        }
                    }
                }
            }

            Rectangle { height: 0.5px; background: #ffffff0f; }

            ScrollView {
                height: root.height - 86px;

                VerticalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 10px;
                    padding-bottom: 12px;
                    spacing: 12px;

                    // SECTION: STARTING POINT
                    VerticalLayout {
                        spacing: 5px;

                        HorizontalLayout {
                            alignment: space-between;

                            Text {
                                text: "STARTING POINT";
                                letter-spacing: 1px;
                                color: #FFFFFF40;
                                font-size: 10px;
                                font-family: "Inter";
                                font-weight: 600;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                background: detect-area.has-hover ? #5DCAA530 : #5DCAA515;
                                border-radius: 3px;
                                border-width: 0.5px;
                                border-color: #5DCAA540;
                                width: 90px;
                                height: 18px;

                                Text {
                                    text: "Auto-detect ED";
                                    color: #5DCAA5;
                                    font-size: 9px;
                                    font-family: "Inter";
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                detect-area := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.auto-detect-location(); }
                                }
                            }
                        }

                        if root.detected-ship-info != "": Rectangle {
                            background: #ffffff06;
                            border-radius: 4px;
                            border-width: 0.5px;
                            border-color: #ffffff10;
                            height: 26px;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: space-between;

                                Text {
                                    text: "Detected Ship:";
                                    color: #FFFFFF60;
                                    font-size: 10px;
                                    font-family: "Inter";
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: root.detected-ship-info;
                                    color: #5DCAA5;
                                    font-size: 10px;
                                    font-family: "Inter";
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            border-color: #FFFFFF0D;
                            background: #ffffff05;
                            border-width: 0.5px;
                            border-radius: 5px;
                            height: 32px;

                            HorizontalLayout {
                                alignment: space-between;
                                padding-right: 10px;
                                padding-left: 10px;

                                Text {
                                    vertical-alignment: center;
                                    text: "Station / System";
                                    color: #FFFFFF99;
                                    font-size: 11px;
                                    font-family: "Inter";
                                }

                                VerticalLayout {
                                    alignment: center;

                                    LineEdit {
                                        edited(val) => {
                                            root.starting-point = val;
                                            root.show-suggestions = val.character-count > 1;
                                            root.station-query-changed(val);
                                        }
                                        text <=> root.starting-point;
                                        placeholder-text: "Type station or system...";
                                        font-size: 11px;
                                        width: 200px;
                                    }
                                }
                            }
                        }

                        if show-suggestions && station-suggestions.length > 0: Rectangle {
                            background: #14151a;
                            border-radius: 5px;
                            border-width: 0.5px;
                            border-color: #ffffff20;
                            height: min(station-suggestions.length * 30px, 150px);
                            clip: true;

                            ListView {
                                for item in root.station-suggestions: Rectangle {
                                    height: 30px;
                                    background: item-area.has-hover ? #ffffff10 : transparent;

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 8px;
                                        alignment: start;

                                        Text {
                                            text: item.name;
                                            color: #ffffff;
                                            font-size: 11px;
                                            font-family: "Inter";
                                            font-weight: 500;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: item.system;
                                            color: #ffffff50;
                                            font-size: 10px;
                                            font-family: "Inter";
                                            vertical-alignment: center;
                                        }
                                    }

                                    item-area := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.station-selected(item.system, item.name);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // SECTION: ROUTE PARAMETERS
                    VerticalLayout {
                        spacing: 4px;

                        Text {
                            text: "ROUTE PARAMETERS";
                            letter-spacing: 1px;
                            color: #FFFFFF40;
                            font-size: 10px;
                            font-family: "Inter";
                            font-weight: 600;
                        }

                        SettingInputRow {
                            label: "Max hops";
                            text: root.max-hops;
                            edited(v) => { root.max-hops = v.to-float(); }
                        }
                        SettingInputRow {
                            label: "Max cargo (t)";
                            text: root.max-cargo;
                            edited(v) => { root.max-cargo = v.to-float(); }
                        }
                        SettingInputRow {
                            label: "Price age (seconds)";
                            text: root.max-price-age;
                            edited(v) => { root.max-price-age = v.to-float(); }
                        }
                        SettingInputRow {
                            label: "Hop distance (LY)";
                            text: root.max-hop-distance;
                            edited(v) => { root.max-hop-distance = v.to-float(); }
                        }
                        SettingInputRow {
                            label: "Starting capital (CR)";
                            text: root.starting-capital;
                            edited(v) => { root.starting-capital = v.to-float(); }
                        }
                        SettingInputRow {
                            label: "Max system distance (LS)";
                            text: root.max-system-distance;
                            edited(v) => { root.max-system-distance = v.to-float(); }
                        }
                    }

                    // SECTION: FILTERS
                    VerticalLayout {
                        spacing: 4px;

                        Text {
                            letter-spacing: 1px;
                            color: #FFFFFF40;
                            text: "FILTERS";
                            font-size: 10px;
                            font-family: "Inter";
                            font-weight: 600;
                        }

                        SettingToggleRow {
                            label: "Requires large landing pad";
                            checked <=> root.requires-large-pad;
                        }
                        SettingToggleRow {
                            label: "Allow player-owned stations/carriers";
                            checked <=> root.allow-player-owned;
                        }
                        SettingToggleRow {
                            label: "Allow planetary stations";
                            checked <=> root.allow-planetary;
                        }
                        SettingToggleRow {
                            label: "Permit required systems";
                            checked <=> root.permit;
                        }
                        SettingToggleRow {
                            label: "Allow prohibited commodities";
                            checked <=> root.allow-prohibited;
                        }
                        SettingToggleRow {
                            label: "Unique systems only (loop)";
                            checked <=> root.unique;
                        }
                        SettingToggleRow {
                            label: "Allow restricted access";
                            checked <=> root.allow-restricted-access;
                        }
                    }

                    // SECTION: APP SETTINGS
                    VerticalLayout {
                        spacing: 4px;

                        Text {
                            letter-spacing: 1px;
                            color: #FFFFFF40;
                            text: "APP SETTINGS";
                            font-size: 10px;
                            font-family: "Inter";
                            font-weight: 600;
                        }

                        SettingToggleRow {
                            label: "Auto-advance route on Journal event";
                            checked <=> root.auto-advance-route;
                        }
                        SettingToggleRow {
                            label: "Auto-sync ship loadout (Cargo & Jump)";
                            checked <=> root.auto-sync-ship;
                        }
                        SettingToggleRow {
                            label: "Auto-copy next system on hop change";
                            checked <=> root.auto-copy-system;
                        }
                        SettingToggleRow {
                            label: "Sound effects (Chimes)";
                            checked <=> root.sound-enabled;
                        }

                        // Hotkey Recording Row
                        Rectangle {
                            border-color: root.is-recording-hotkey ? #5DCAA580 : #FFFFFF0D;
                            background: root.is-recording-hotkey ? #5DCAA510 : #ffffff05;
                            border-width: 0.5px;
                            border-radius: 5px;
                            height: 32px;

                            HorizontalLayout {
                                alignment: space-between;
                                padding-right: 10px;
                                padding-left: 10px;

                                Text {
                                    vertical-alignment: center;
                                    color: #FFFFFF99;
                                    text: "Global Hotkey (Toggle Overlay)";
                                    font-size: 11px;
                                    font-family: "Inter";
                                }

                                VerticalLayout {
                                    alignment: center;

                                    HorizontalLayout {
                                        alignment: end;
                                        spacing: 5px;

                                        Rectangle {
                                            background: root.is-recording-hotkey ? #5DCAA525 : (hotkey-btn.has-hover ? #ffffff15 : #ffffff0a);
                                            border-color: root.is-recording-hotkey ? #5DCAA5 : #ffffff18;
                                            border-width: 0.5px;
                                            border-radius: 4px;
                                            height: 22px;

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                alignment: center;

                                                Text {
                                                    text: root.is-recording-hotkey ? "Press shortcut..." : root.hotkey-str;
                                                    color: root.is-recording-hotkey ? #5DCAA5 : #FFFFFF;
                                                    font-size: 11px;
                                                    font-family: "Inter";
                                                    font-weight: root.is-recording-hotkey ? 600 : 500;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            hotkey-btn := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.is-recording-hotkey = !root.is-recording-hotkey;
                                                    if (root.is-recording-hotkey) {
                                                        root.hotkey-recording-started();
                                                        hotkey-focus.focus();
                                                    } else {
                                                        root.hotkey-recording-ended();
                                                    }
                                                }
                                            }
                                        }

                                        if root.hotkey-str != "Ctrl+Shift+V" && !root.is-recording-hotkey: Rectangle {
                                            width: 22px;
                                            height: 22px;
                                            border-radius: 4px;
                                            background: reset-hk.has-hover ? #ffffff15 : transparent;

                                            HorizontalLayout {
                                                alignment: center;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        source: @image-url("assets/reset.svg");
                                                        colorize: reset-hk.has-hover ? #FFFFFF : #FFFFFF70;
                                                        width: 12px;
                                                        height: 12px;
                                                    }
                                                }
                                            }

                                            reset-hk := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.hotkey-str = "Ctrl+Shift+V";
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Custom Journal Folder (No focus-stealing LineEdit)
                        Rectangle {
                            border-color: #FFFFFF0D;
                            background: #ffffff05;
                            border-width: 0.5px;
                            border-radius: 5px;
                            height: 32px;

                            HorizontalLayout {
                                alignment: space-between;
                                padding-right: 10px;
                                padding-left: 10px;

                                Text {
                                    vertical-alignment: center;
                                    color: #FFFFFF99;
                                    text: "Custom Journal Folder";
                                    font-size: 11px;
                                    font-family: "Inter";
                                }

                                VerticalLayout {
                                    alignment: center;

                                    HorizontalLayout {
                                        alignment: end;
                                        spacing: 5px;

                                        Rectangle {
                                            background: #ffffff08;
                                            border-color: #ffffff10;
                                            border-width: 0.5px;
                                            border-radius: 4px;
                                            height: 22px;
                                            max-width: 170px;

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;

                                                Text {
                                                    text: root.journal-path != "" ? root.journal-path : "Default (Auto-detect)";
                                                    color: root.journal-path != "" ? #FFFFFF : #FFFFFF50;
                                                    font-size: 10px;
                                                    font-family: "Inter";
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        Rectangle {
                                            background: browse-btn.has-hover ? #5DCAA530 : #ffffff10;
                                            border-radius: 3px;
                                            border-width: 0.5px;
                                            border-color: #ffffff15;
                                            width: 50px;
                                            height: 22px;

                                            Text {
                                                text: "Browse";
                                                color: #5DCAA5;
                                                font-size: 10px;
                                                font-family: "Inter";
                                                font-weight: 600;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }

                                            browse-btn := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.browse-journal-path(); }
                                            }
                                        }

                                        if root.journal-path != "": Rectangle {
                                            width: 18px;
                                            height: 18px;
                                            border-radius: 3px;
                                            background: clear-path.has-hover ? #ff5f5725 : transparent;

                                            Image {
                                                source: @image-url("assets/close.svg");
                                                colorize: clear-path.has-hover ? #ff5f57 : #FFFFFF50;
                                                height: 9px;
                                                width: 9px;
                                            }

                                            clear-path := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.journal-path = "";
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle { height: 0.5px; background: #ffffff0f; }

            // Footer Actions
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 8px;
                height: 44px;

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "v1.0";
                        color: #FFFFFF35;
                        font-size: 10px;
                        font-family: "Inter";
                        font-weight: 500;
                    }
                }

                Rectangle {
                    border-radius: 5px;
                    background: close-btn.has-hover ? #ffffff15 : #ffffff08;
                    border-width: 0.5px;
                    border-color: #ffffff14;
                    horizontal-stretch: 1;

                    Text {
                        text: "Cancel";
                        color: #ffffff80;
                        font-size: 11px;
                        font-family: "Inter";
                        font-weight: 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    close-btn := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if (root.is-recording-hotkey) {
                                root.is-recording-hotkey = false;
                                root.hotkey-recording-ended();
                            }
                            root.close-window();
                        }
                    }
                }

                Rectangle {
                    border-radius: 5px;
                    background: save-btn.has-hover ? #4db896 : #5DCAA5;
                    horizontal-stretch: 1;

                    Text {
                        text: "Save Settings";
                        color: #04342C;
                        font-size: 11px;
                        font-family: "Inter";
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    save-btn := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if (root.is-recording-hotkey) {
                                root.is-recording-hotkey = false;
                                root.hotkey-recording-ended();
                            }
                            root.save();
                        }
                    }
                }
            }
        }
    }
}
